---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import equipPhoto from '../assets/photos/equip-utrecht.jpg';

const stats = [
	{ value: '8', label: 'Partnerkerken' },
	{ value: '1', label: 'Kerkplanting' },
	{ value: '100+', label: 'Landen partneren wereldwijd' },
	{ value: '1983', label: 'Sinds' },
];
---

<Layout title="Home">
	<section class="relative">
		<Image
			src={equipPhoto}
			alt="NCMI Europe Equip training in Utrecht"
			class="h-[560px] w-full object-cover"
			widths={[640, 1024, 1600]}
			sizes="100vw"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-[#10243D]/95 via-[#10243D]/80 to-[#10243D]/40"></div>
		<div class="absolute inset-0 flex items-center">
			<div class="mx-auto w-full max-w-6xl px-6 text-white">
				<p class="text-xs font-bold uppercase tracking-[0.25em] text-[#E8A33D]">
					Trans-lokaal team &middot; Apostolisch-profetisch hart
				</p>
				<h1 class="mt-4 max-w-2xl text-4xl font-black uppercase leading-[1.05] md:text-6xl">
					Jezus kennen en Hem bekend maken
				</h1>
				<p class="mt-6 max-w-xl text-lg text-white/85">
					[Placeholder-tekst] Dát is waarom we bestaan. NCMI Nederland is geen organisatie en geen
					agenda vol events, maar een team van gaven dat naast plaatselijke kerken gaat staan.
				</p>
				<div class="mt-8 flex flex-wrap gap-4">
					<a
						href="/over-ons"
						class="rounded bg-[#E8A33D] px-6 py-3 text-sm font-bold uppercase tracking-wide text-[#10243D] hover:bg-[#f0b45c] transition-colors"
					>
						Vind een kerk
					</a>
					<a
						href="/agenda"
						class="rounded border border-white/50 px-6 py-3 text-sm font-bold uppercase tracking-wide hover:border-[#E8A33D] hover:text-[#E8A33D] transition-colors"
					>
						Agenda
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-[#10243D]">
		<div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-6 py-14 md:grid-cols-4">
			{stats.map((s) => (
				<div>
					<p class="text-4xl font-black text-[#E8A33D] md:text-5xl">{s.value}</p>
					<p class="mt-2 text-xs font-bold uppercase tracking-wide text-white/70">{s.label}</p>
				</div>
			))}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-16">
		<p class="text-xs font-bold uppercase tracking-[0.25em] text-slate-400">Wat we doen</p>
		<h2 class="mt-3 text-3xl font-black text-[#10243D]">Samen kerken bouwen</h2>
		<p class="mt-4 max-w-3xl text-slate-600">
			[Placeholder — vervang met echte NL-tekst] NCMI is een trans-lokaal team dat pastors en
			kerken helpt bouwen, gelovigen toerust en meewerkt aan het planten van nieuwe kerken.
		</p>
		<div class="mt-10 grid gap-8 md:grid-cols-3">
			<div class="rounded-lg border border-slate-200 p-6">
				<h3 class="font-bold uppercase tracking-wide text-[#10243D]">Resources</h3>
				<p class="mt-2 text-sm text-slate-600">Boeken, video's en materiaal voor kerkplanters en leiders.</p>
			</div>
			<div class="rounded-lg border border-slate-200 p-6">
				<h3 class="font-bold uppercase tracking-wide text-[#10243D]">Agenda</h3>
				<p class="mt-2 text-sm text-slate-600">Trainingen, Equips en GTT's — bekijk de eerstvolgende events.</p>
			</div>
			<div class="rounded-lg border border-slate-200 p-6">
				<h3 class="font-bold uppercase tracking-wide text-[#10243D]">Partnerschap</h3>
				<p class="mt-2 text-sm text-slate-600">Samen kerken bouwen, in verbinding met het wereldwijde NCMI-netwerk.</p>
			</div>
		</div>
	</section>
</Layout>
