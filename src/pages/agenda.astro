---
import Layout from '../layouts/Layout.astro';

// Placeholder data — wordt in fase 1 vervangen door content uit Sanity CMS.
const filters = ['Alles', 'Regiodag', 'Equip', 'Training', 'Cursus', 'Gebed'];

const events = [
	{ day: '26', dayLabel: 'za sep', month: 'September 2026', category: 'Regiodag', title: 'Regiodag Midden-Nederland', venue: 'Central City Church Utrecht', city: 'Utrecht', time: '10:00 – 16:00' },
	{ day: '14', dayLabel: 'wo okt', month: 'Oktober 2026', category: 'Equip', title: 'Equip Training Utrecht', venue: 'Locatie volgt', city: 'Utrecht', time: '19:00 – 21:30' },
];
---

<Layout title="Agenda">
	<section class="bg-[#10243D] text-white">
		<div class="mx-auto max-w-6xl px-6 py-14">
			<p class="text-xs font-bold uppercase tracking-[0.25em] text-[#E8A33D]">Agenda</p>
			<h1 class="mt-3 text-3xl font-black uppercase md:text-4xl">Alles wat er gebeurt</h1>
			<p class="mt-4 max-w-2xl text-white/80">
				Regiodagen, Equips, trainingen en gebed van alle partnerkerken — op één plek.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-10">
		<div class="flex flex-wrap gap-3">
			{filters.map((f, i) => (
				<button
					class:list={[
						'rounded border px-4 py-2 text-xs font-bold uppercase tracking-wide transition-colors',
						i === 0
							? 'border-[#10243D] bg-[#10243D] text-white'
							: 'border-slate-200 text-slate-600 hover:border-[#10243D]',
					]}
				>
					{f}
				</button>
			))}
		</div>

		{Object.entries(
			events.reduce((acc: Record<string, typeof events>, e) => {
				(acc[e.month] ||= []).push(e);
				return acc;
			}, {})
		).map(([month, monthEvents]) => (
			<div class="mt-10">
				<p class="text-xs font-bold uppercase tracking-wide text-slate-400">{month}</p>
				<ul class="mt-4 divide-y divide-slate-200 border-t border-slate-200">
					{monthEvents.map((e) => (
						<li class="flex items-center justify-between gap-6 py-6">
							<div class="flex items-center gap-6">
								<div class="text-center">
									<p class="text-2xl font-black text-[#10243D]">{e.day}</p>
									<p class="text-xs font-bold uppercase tracking-wide text-slate-400">{e.dayLabel}</p>
								</div>
								<div>
									<p class="text-xs font-bold uppercase tracking-wide text-[#E8A33D]">{e.category}</p>
									<h2 class="font-bold text-[#10243D]">{e.title}</h2>
									<p class="text-sm text-slate-500">{e.venue}</p>
								</div>
							</div>
							<div class="hidden text-right text-sm text-slate-500 sm:block">
								<p>{e.city}</p>
								<p>{e.time}</p>
							</div>
						</li>
					))}
				</ul>
			</div>
		))}
	</section>
</Layout>
