---
import Layout from '../layouts/Layout.astro';

// Placeholder data — wordt in fase 1 vervangen door content uit Sanity CMS.
const filters = ['Alles', 'Regiodag', 'Equip', 'Training', 'Cursus', 'Gebed'];

const events = [
	{ day: '26', month: 'sep', year: '2026', category: 'Regiodag', title: 'Regiodag Midden-Nederland', where: 'Central City Church Utrecht, Utrecht', time: '10:00 – 16:00' },
	{ day: '14', month: 'okt', year: '2026', category: 'Equip', title: 'Equip Training Utrecht', where: 'Locatie volgt, Utrecht', time: '19:00 – 21:30' },
];

const eyebrow = 'font-size:11.5px;font-weight:800;letter-spacing:.24em;text-transform:uppercase;color:rgba(255,255,255,.55)';
---

<Layout title="Agenda">
	<section style="background:#10243D">
		<div style="max-width:1320px;margin:0 auto;padding:96px 32px">
			<div style={eyebrow}>Agenda</div>
			<h1 style="margin:16px 0 0;font-weight:800;font-size:clamp(30px,3.8vw,54px);line-height:1;letter-spacing:-.02em;text-transform:uppercase;color:#fff">Alles wat er gebeurt</h1>
			<p style="margin:20px 0 0;max-width:56ch;font-size:17.5px;line-height:1.65;color:rgba(255,255,255,.75)">
				Regiodagen, Equips, trainingen en gebed van alle partnerkerken — op één plek. Geen agenda om
				de agenda: elke dag staat in dienst van de plaatselijke kerk.
			</p>
		</div>
	</section>

	<section style="background:#F1F5F9;border-bottom:1px solid #D8E0E8">
		<div style="max-width:1320px;margin:0 auto;padding:28px 32px;display:flex;flex-wrap:wrap;gap:10px">
			{filters.map((f, i) => (
				<button
					style={`padding:11px 18px;border:1px solid ${i === 0 ? '#10243D' : '#D8E0E8'};background:${i === 0 ? '#10243D' : '#fff'};color:${i === 0 ? '#fff' : '#3C4A5A'};font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;cursor:pointer`}
				>
					{f}
				</button>
			))}
		</div>
	</section>

	<section style="background:#fff">
		<div style="max-width:1320px;margin:0 auto;padding:0 32px">
			{events.map((ev) => (
				<a href="/agenda" style="display:grid;grid-template-columns:132px 1fr auto;gap:30px;align-items:center;padding:30px 0;border-bottom:1px solid #D8E0E8;color:#10243D;text-decoration:none">
					<span style="display:block">
						<span style="display:block;font-size:46px;font-weight:800;line-height:1;letter-spacing:-.03em">{ev.day}</span>
						<span style="display:block;margin-top:4px;font-size:11.5px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:#71808F">{ev.month} {ev.year}</span>
					</span>
					<span style="min-width:0">
						<span style="display:block;font-size:11px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:#71808F">{ev.category}</span>
						<span style="display:block;margin-top:8px;font-size:24px;font-weight:700;letter-spacing:-.01em">{ev.title}</span>
						<span style="display:block;margin-top:7px;font-size:15px;color:#71808F">{ev.where} &middot; {ev.time}</span>
					</span>
					<span style="font-size:22px;color:#71808F">&rarr;</span>
				</a>
			))}
		</div>
	</section>
</Layout>
