---
import Layout from '../layouts/Layout.astro';

// Placeholder data — wordt in fase 1 vervangen door content uit Sanity CMS.
const resources = [
	{ title: 'Voorbeeld resource 1', type: 'Boek' },
	{ title: 'Voorbeeld resource 2', type: 'Video' },
	{ title: 'Voorbeeld resource 3', type: 'Podcast' },
];
---

<Layout title="Resources">
	<section class="mx-auto max-w-6xl px-6 py-16">
		<h1 class="text-3xl font-bold text-[#10243D]">Resources</h1>
		<p class="mt-3 max-w-2xl text-slate-600">
			Materiaal om kerkplanters en leiders toe te rusten. Deze lijst komt straks uit het CMS,
			zodat die zelf beheerd kan worden zonder ontwikkelaar.
		</p>
		<ul class="mt-10 grid gap-6 md:grid-cols-3">
			{resources.map((r) => (
				<li class="rounded-lg border border-slate-200 p-6">
					<span class="text-xs font-semibold uppercase tracking-wide text-[#E8A33D]">{r.type}</span>
					<h2 class="mt-2 font-semibold text-[#10243D]">{r.title}</h2>
				</li>
			))}
		</ul>
	</section>
</Layout>
