---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import identityImg from '../assets/photos/identity-series.jpg';
import kinderwerkImg from '../assets/photos/kinderwerk.jpg';
import booksImg from '../assets/photos/resources-books.jpg';
import equipImg from '../assets/photos/equip-utrecht.jpg';

// Placeholder data — wordt in fase 1 vervangen door content uit Sanity CMS.
const resources = [
	{ image: identityImg, category: 'Prekenserie', meta: '6 delen', title: 'Aan tafel', description: "Serie over gastvrijheid, genade en de plek aan Jezus' tafel — met vragen voor kleine groepen.", sharedBy: 'Life Church Nijkerk' },
	{ image: kinderwerkImg, category: 'Kinderwerk', meta: '8 lessen', title: 'Helden van het geloof (6–9 jr)', description: 'Lesblok met verhaalplaten, werkbladen en knutselideeën.', sharedBy: 'WegwijzerKidz' },
	{ image: booksImg, category: 'Cursus', meta: '10 avonden', title: 'Alpha-cursus — draaiboek', description: 'Praktisch draaiboek om Alpha in je eigen gemeente te draaien.', sharedBy: 'De Wegwijzer Hardenberg' },
	{ image: equipImg, category: 'Video', meta: "5 video's", title: 'Equip Nederland — alle sessies', description: 'Opnames van Nederlandse en Engelse sessies van de laatste Equip.', sharedBy: 'NCMI Nederland' },
	{ image: identityImg, category: 'Prekenserie', meta: '9 delen', title: 'Jezus centraal', description: 'Doorlopende serie over wie Jezus is en wat dat betekent voor de stad.', sharedBy: 'Alive, De Bilt' },
	{ image: booksImg, category: 'Cursus', meta: '4 modules', title: 'Oudsten toerusten', description: 'Voor teams die leiders begeleiden en aanstellen.', sharedBy: 'NCMI Nederland' },
];
---

<Layout title="Resources">
	<section style="background:#10243D">
		<div style="max-width:1320px;margin:0 auto;padding:96px 32px">
			<div style="font-size:11.5px;font-weight:800;letter-spacing:.24em;text-transform:uppercase;color:rgba(255,255,255,.55)">Resources</div>
			<h1 style="margin:16px 0 0;font-weight:800;font-size:clamp(30px,3.8vw,54px);line-height:1;letter-spacing:-.02em;text-transform:uppercase;color:#fff;max-width:22ch">Gedeeld door de kerken, voor de kerken</h1>
			<p style="margin:20px 0 0;max-width:56ch;font-size:17.5px;line-height:1.65;color:rgba(255,255,255,.75)">
				Preken, cursussen en materiaal van partnerkerken — vrij te gebruiken in je eigen gemeente.
			</p>
		</div>
	</section>

	<section style="background:#fff">
		<ul style="max-width:1320px;margin:0 auto;padding:88px 32px;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1px;background:#D8E0E8;border:1px solid #D8E0E8">
			{resources.map((r) => (
				<li style="background:#fff">
					<a href="/resources" style="display:block;color:#10243D;text-decoration:none">
						<span style="display:block;height:186px;overflow:hidden">
							<Image src={r.image} alt={r.title} style="width:100%;height:100%;object-fit:cover;display:block" widths={[400, 800]} sizes="350px" />
						</span>
						<span style="display:block;padding:26px">
							<span style="font-size:10.5px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:#71808F">{r.category} &middot; {r.meta}</span>
							<span style="display:block;margin-top:10px;font-size:20px;font-weight:700">{r.title}</span>
							<span style="display:block;margin-top:10px;font-size:14.5px;line-height:1.6;color:#3C4A5A">{r.description}</span>
							<span style="display:block;margin-top:20px;padding-top:16px;border-top:1px solid #D8E0E8;font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#71808F">
								Gedeeld door {r.sharedBy}
							</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
</Layout>
