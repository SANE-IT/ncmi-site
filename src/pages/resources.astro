---
import Layout from '../layouts/Layout.astro';

// Placeholder data — wordt in fase 1 vervangen door content uit Sanity CMS.
const resources = [
	{ category: 'Prekenserie', meta: '6 delen', title: 'Aan tafel', description: "Serie over gastvrijheid, genade en de plek aan Jezus' tafel — met vragen voor kleine groepen.", sharedBy: 'Life Church Nijkerk' },
	{ category: 'Kinderwerk', meta: '8 lessen', title: 'Helden van het geloof (6–9 jr)', description: 'Lesblok met verhaalplaten, werkbladen en knutselideeën.', sharedBy: 'WegwijzerKidz' },
	{ category: 'Cursus', meta: '10 avonden', title: 'Alpha-cursus — draaiboek', description: 'Praktisch draaiboek om Alpha in je eigen gemeente te draaien.', sharedBy: 'De Wegwijzer Hardenberg' },
];
---

<Layout title="Resources">
	<section class="bg-[#10243D] text-white">
		<div class="mx-auto max-w-6xl px-6 py-14">
			<p class="text-xs font-bold uppercase tracking-[0.25em] text-[#E8A33D]">Resources</p>
			<h1 class="mt-3 text-3xl font-black uppercase md:text-4xl">Materiaal om te delen en te groeien</h1>
			<p class="mt-4 max-w-2xl text-white/80">
				Preken, cursussen en materiaal van partnerkerken — vrij te gebruiken in je eigen gemeente.
			</p>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-14">
		<ul class="grid gap-8 md:grid-cols-3">
			{resources.map((r) => (
				<li class="overflow-hidden rounded-lg border border-slate-200">
					<div class="flex h-40 items-center justify-center bg-slate-100 text-sm text-slate-400">
						[afbeelding]
					</div>
					<div class="p-6">
						<span class="text-xs font-bold uppercase tracking-wide text-[#E8A33D]">
							{r.category} &middot; {r.meta}
						</span>
						<h2 class="mt-2 text-lg font-bold text-[#10243D]">{r.title}</h2>
						<p class="mt-2 text-sm text-slate-600">{r.description}</p>
						<p class="mt-4 border-t border-slate-100 pt-4 text-xs font-bold uppercase tracking-wide text-slate-400">
							Gedeeld door {r.sharedBy}
						</p>
					</div>
				</li>
			))}
		</ul>
	</section>
</Layout>
