---
import Layout from '../layouts/Layout.astro';

// Placeholder data — wordt in fase 1 vervangen door content uit Sanity CMS.
const regions = [
	{ name: 'Noord-Nederland', count: 1 },
	{ name: 'Midden-Nederland', count: 3 },
	{ name: 'Zuid-Nederland', count: 4 },
];
---

<Layout title="Kerken">
	<section class="mx-auto max-w-6xl px-6 py-16">
		<p class="text-xs font-bold uppercase tracking-[0.25em] text-slate-400">NCMI Nederland</p>
		<h1 class="mt-3 text-3xl font-black text-[#10243D] md:text-4xl">
			Eén visie, <span class="text-[#E8A33D]">acht</span> gemeenten
		</h1>
		<p class="mt-4 max-w-2xl text-slate-600">
			Partneren is meer dan kennen: we werken samen. Het team gaat in en uit de plaatselijke kerk,
			rust gelovigen toe en plant nieuwe gemeenten. Vind een kerk bij jou, kom naar een regiodag, of
			gebruik wat de kerken delen.
		</p>
		<div class="mt-8 flex flex-wrap gap-4">
			<a href="#regios" class="rounded bg-[#10243D] px-6 py-3 text-sm font-bold uppercase tracking-wide text-white hover:bg-[#16335a] transition-colors">
				Kerken in kaart
			</a>
			<a href="/resources" class="rounded border border-[#10243D] px-6 py-3 text-sm font-bold uppercase tracking-wide text-[#10243D] hover:bg-[#10243D] hover:text-white transition-colors">
				Resources
			</a>
		</div>
	</section>

	<section id="regios" class="border-t border-slate-100 bg-slate-50">
		<div class="mx-auto max-w-6xl px-6 py-16">
			<h2 class="text-2xl font-black text-[#10243D] md:text-3xl">Van Coevorden tot Eindhoven</h2>
			<p class="mt-3 max-w-2xl text-slate-600">
				Klik een regio voor de gemeenten die daar met het team partneren.
			</p>
			<ul class="mt-8 grid gap-4 sm:grid-cols-3">
				{regions.map((r) => (
					<li class="flex items-center justify-between rounded-lg border border-slate-200 bg-white px-6 py-4">
						<span class="font-bold text-[#10243D]">{r.name}</span>
						<span class="rounded-full bg-[#10243D]/5 px-3 py-1 text-sm font-bold text-[#10243D]">{r.count}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="bg-[#10243D]">
		<div class="mx-auto max-w-6xl px-6 py-16 text-center text-white">
			<h2 class="text-2xl font-black md:text-3xl">Partneren met het NCMI-team?</h2>
			<p class="mx-auto mt-4 max-w-xl text-white/80">
				Partnerschap is Gods idee, niet het onze. De oudsten blijven de hoogste leiding in de
				gemeente; het team geeft input, rust toe en gaat mee het onbekende in.
			</p>
			<a
				href="/contact"
				class="mt-8 inline-block rounded bg-[#E8A33D] px-6 py-3 text-sm font-bold uppercase tracking-wide text-[#10243D] hover:bg-[#f0b45c] transition-colors"
			>
				Connect
			</a>
		</div>
	</section>
</Layout>
