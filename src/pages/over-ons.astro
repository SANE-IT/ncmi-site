---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import kinderwerkPhoto from '../assets/photos/kinderwerk.jpg';
---

<Layout title="Over ons">
	<section class="mx-auto max-w-6xl px-6 py-16">
		<p class="text-xs font-bold uppercase tracking-[0.25em] text-slate-400">Over NCMI</p>
		<h1 class="mt-3 text-3xl font-black text-[#10243D] md:text-4xl">Wie is NCMI?</h1>
		<p class="mt-4 max-w-2xl text-slate-600">
			[Placeholder — vervang met echte NL-tekst] NCMI is een trans-lokaal team met een apostolisch-profetisch
			hart: een team van de gaven uit Efeze 4:11 — apostel, profeet, evangelist, pastor en leraar —
			dat in en uit de plaatselijke kerk de volken ingaat. Geen rondtrekkend spreekcircuit en geen
			bestuurslaag, maar mensen die pastors en oudsten helpen hun gemeente te bouwen.
		</p>
		<div class="mt-8 flex flex-wrap gap-4">
			<a
				href="https://ncmi.net"
				target="_blank"
				rel="noopener"
				class="rounded border border-[#10243D] px-6 py-3 text-sm font-bold uppercase tracking-wide text-[#10243D] hover:bg-[#10243D] hover:text-white transition-colors"
			>
				NCMI Europa ↗
			</a>
			<a
				href="https://ncmi.net"
				target="_blank"
				rel="noopener"
				class="rounded border border-[#10243D] px-6 py-3 text-sm font-bold uppercase tracking-wide text-[#10243D] hover:bg-[#10243D] hover:text-white transition-colors"
			>
				NCMI Global ↗
			</a>
		</div>
		<Image
			src={kinderwerkPhoto}
			alt="Kinderwerk bij een NCMI-partnerkerk"
			class="mt-12 h-72 w-full rounded-lg object-cover"
			widths={[640, 1024]}
			sizes="100vw"
		/>
	</section>
</Layout>
