---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
	<section class="mx-auto max-w-6xl px-6 py-16">
		<p class="text-xs font-bold uppercase tracking-[0.25em] text-slate-400">Contact</p>
		<h1 class="mt-3 text-3xl font-black text-[#10243D] md:text-4xl">Neem contact op</h1>
		<p class="mt-4 max-w-2xl text-slate-600">
			[Placeholder] Een echt contactformulier kan later toegevoegd worden. Voor nu:
		</p>
		<p class="mt-6 text-lg font-bold text-[#10243D]">info@ncmi.nl</p>
	</section>
</Layout>
