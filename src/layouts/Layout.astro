---
import '../styles/global.css';
import logo from '../assets/brand/logo-ncmi-white.png';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'NCMI Nederland — trans-lokaal team dat kerken plant en leiders toerust.' } = Astro.props;

const navItems = [
	{ href: '/kerken', label: 'Kerken' },
	{ href: '/agenda', label: 'Agenda' },
	{ href: '/resources', label: 'Resources' },
	{ href: '/over-ons', label: 'Over' },
];
---

<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
		<title>{title} · NCMI Nederland</title>
	</head>
	<body class="bg-white text-slate-900">
		<header class="bg-[#10243D] text-white">
			<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
				<a href="/" class="flex items-center gap-4">
					<img src={logo.src} alt="NCMI" class="h-8 w-auto" />
					<span class="h-6 w-px bg-white/28"></span>
					<span class="text-xs font-bold uppercase tracking-[0.26em] text-white/72">Nederland</span>
				</a>
				<nav class="hidden items-center gap-8 text-sm font-bold uppercase tracking-wide md:flex">
					{navItems.map((item) => (
						<a href={item.href} class="hover:text-[#E8A33D] transition-colors">{item.label}</a>
					))}
					<a
						href="/contact"
						class="rounded border border-white/40 px-4 py-2 text-xs hover:border-[#E8A33D] hover:text-[#E8A33D] transition-colors"
					>
						Connect
					</a>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="bg-[#10243D] text-white/60">
			<div class="mx-auto max-w-6xl px-6 py-10 text-sm">
				<p>&copy; {new Date().getFullYear()} NCMI Nederland. Alle rechten voorbehouden.</p>
			</div>
		</footer>
	</body>
</html>
